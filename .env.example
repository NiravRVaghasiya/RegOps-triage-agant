# Copy to .env (gitignored) and fill in. Never commit real keys.

# gemini (default) | openai | anthropic | ollama | offline
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-google-ai-studio-key

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# EMBEDDINGS_PROVIDER=gemini          # defaults to LLM_PROVIDER (anthropic -> offline)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Persistent Chroma index directory (rebuilt automatically when rules or embedding model change)
CHROMA_DIR=.chroma
